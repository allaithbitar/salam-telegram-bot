FROM oven/bun:1-alpine

WORKDIR /app

COPY package*.json jsconfig.json .

RUN bun install

COPY ./src ./src

ARG POSTGRES_HOST

ARG POSTGRES_PORT

ARG POSTGRES_USER

ARG POSTGRES_DB

ARG POSTGRES_PASSWORD 

ARG API_PORT

ARG API_HOST

ARG BOT_TOKEN

ARG DASHBOARD_HOST

# ARG DASHBOARD_PORT

ARG SETTINGS_TOKEN_HASH_SALT

ARG SETTINGS_TOKEN_IV

ARG VALKEY_HOST

ENV POSTGRES_HOST=$POSTGRES_HOST

ENV POSTGRES_PORT=$POSTGRES_PORT

ENV POSTGRES_USER=$POSTGRES_USER

ENV POSTGRES_DB=$POSTGRES_DB

ENV POSTGRES_PASSWORD=$POSTGRES_PASSWORD 

ENV API_PORT=$API_PORT 

ENV API_HOST=$API_HOST 

ENV BOT_TOKEN=$BOT_TOKEN

ENV DASHBOARD_HOST=$DASHBOARD_HOST

# ENV DASHBOARD_PORT=$DASHBOARD_PORT

ENV SETTINGS_TOKEN_HASH_SALT=$SETTINGS_TOKEN_HASH_SALT

ENV SETTINGS_TOKEN_IV=$SETTINGS_TOKEN_IV

ENV VALKEY_HOST=$VALKEY_HOST

RUN bun run build 

EXPOSE 3000

EXPOSE 8080

CMD bun run start:production

